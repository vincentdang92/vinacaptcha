PORT=3000
BACKEND_REDIS_URL=redis://localhost:6379
DB_HOST=localhost
DB_PORT=5432
DB_USER=captcha_user
DB_PASSWORD=your_secure_db_password
DB_NAME=captcha_db

JWT_SECRET=your_super_secret_jwt_random_string_2026
APP_SALT=your_secure_salt_random_string_2026
# URL công khai dùng để dựng link trong email (kích hoạt tài khoản, đặt lại mật khẩu).
# Production: đặt APP_URL=https://<domain> để link không phụ thuộc header Host/Origin của request.
# Giá trị localhost bị bỏ qua khi dựng link; dev sẽ tự lấy theo Origin của Dashboard (Vite port 3069).
APP_URL=http://localhost:3068
DASHBOARD_URL=http://localhost:3069

# Threat Intelligence API Keys (Optional)
BACKEND_ABUSEIPDB_KEY=

# SMTP Email Configuration (For account activation & quota alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@domain.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME="NhanHoaCaptcha System"
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_IGNORE_TLS=false