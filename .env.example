# ==========================================================
# NhanHoaCaptcha Production Environment Configuration
# Sao chép file này thành .env trên VPS: cp .env.example .env
# ==========================================================

# 1. Cổng lắng nghe ngoài Gateway
PORT_HTTP=80

# URL công khai của hệ thống (Dashboard + API cùng domain), dùng cho link kích hoạt tài khoản
# và đặt lại mật khẩu trong email. Nên đặt khi chạy production (VD: https://captcha.domain.com);
# ssl.sh tự ghi giá trị này. Để trống thì backend tự nhận diện theo request của trình duyệt.
APP_URL=

# 2. Database PostgreSQL
POSTGRES_USER=captcha_user
POSTGRES_PASSWORD=captcha_password_super_secure_change_me
POSTGRES_DB=captcha_db

# 3. Bảo mật JWT & Salt
JWT_SECRET=vina_captcha_prod_secret_key_2026_super_secure_random_string

# 4. Threat Intelligence API Keys (Tùy chọn)
ABUSEIPDB_KEY=

# 5. Cấu hình Email SMTP (Kích hoạt tài khoản & Cảnh báo Quota - Tùy chọn)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

